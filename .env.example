# 1. Токен бота — получить у @BotFather в Telegram (команда /newbot)
TELEGRAM_BOT_TOKEN=

# 2. Нейросеть для текстов. По умолчанию Gemini от Google (есть бесплатный тариф).
#    Ключ: aistudio.google.com → Get API key → Create API key
AI_PROVIDER=gemini
AI_API_KEY=
#    Другая модель или нейросеть (необязательно):
#    AI_PROVIDER=openai   + AI_MODEL=название модели ChatGPT, ключ с platform.openai.com
#    AI_PROVIDER=deepseek + AI_MODEL=название модели DeepSeek, ключ с platform.deepseek.com
AI_MODEL=

# 3. Твой Telegram ID (бот покажет его при /start) — чтобы ботом пользовалась только ты.
#    Несколько человек — через запятую.
ALLOWED_USERS=

# 4. (необязательно) Канал для кнопки «Опубликовать». Бота нужно сделать админом канала.
CHANNEL_ID=@AVTOBLOGRF

# Точность субтитров: small (быстро) или medium (точнее, медленнее)
WHISPER_MODEL=small
# Для скачивания отзывов из Telegram — получить на my.telegram.org → API development tools
TG_API_ID=
TG_API_HASH=

# Запасная нейросеть — Qwen (Alibaba). Если Gemini откажет (страна, лимит, перегрузка), бот сам перейдёт на неё.
# Пока BACKUP_API_KEY пустой — запасная выключена.
# Ключ: alibabacloud.com → Model Studio (регион Singapore) → API key. Workspace ID — там же, рядом с ключом.
BACKUP_PROVIDER=qwen
BACKUP_API_KEY=
QWEN_WORKSPACE_ID=
BACKUP_MODEL=
